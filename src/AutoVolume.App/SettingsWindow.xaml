<Window x:Class="AutoVolume.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoVolume 设置" Width="940" Height="680" MinWidth="840" MinHeight="580"
        Background="{StaticResource PageBg}" FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image x:Name="AppIconImage" Width="30" Height="30" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AutoVolume" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="监听中" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ============ 音量方案 ============ -->
            <TabItem Header="音量方案">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新增" Style="{StaticResource GhostButton}" Click="OnAddScheme" />
                                <Button Content="删除" Style="{StaticResource GhostButton}" Click="OnRemoveScheme" Margin="8,0,0,0" />
                            </StackPanel>
                            <ListBox x:Name="SchemeList" BorderThickness="0" Background="Transparent"
                                     DisplayMemberPath="Name" SelectionChanged="OnSchemeSelected" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="方案名称" Style="{StaticResource SectionTitle}" />
                            <TextBox x:Name="SchemeName" TextChanged="OnSchemeNameChanged" />

                            <TextBlock Text="成员应用（同一方案共用系统音量）" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="8">
                                <StackPanel>
                                    <ListBox x:Name="MemberList" Height="150" BorderThickness="0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="AppPicker" IsEditable="True" Grid.Column="0" />
                                        <Button Content="添加" Style="{StaticResource GhostButton}" Grid.Column="1"
                                                Margin="8,0,0,0" Click="OnAddMember" />
                                        <Button Content="移除" Style="{StaticResource GhostButton}" Grid.Column="2"
                                                Margin="8,0,0,0" Click="OnRemoveMember" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="系统音量（当前输出设备）" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="VolumeEnabled" Content="进入此方案时设置系统音量"
                                              Margin="0,0,0,10" Checked="OnVolumeEnabledChanged" Unchecked="OnVolumeEnabledChanged" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="VolumeLabel" Grid.Column="1" Text="10%"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="首次进入某方案不会动音量；之后你手动调的音量会被记住。"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 应用与控制 ============ -->
            <TabItem Header="应用与控制">
                <Border Style="{StaticResource Card}" Margin="0,12,0,4">
                    <StackPanel>
                        <TextBlock Text="角色决定应用是触发方还是被暂停方；同一应用只能有一个角色。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="应用" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="角色" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="控制方式" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </Grid>
                        <ScrollViewer Height="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RoleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding RoleIndex, Mode=TwoWay}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="不参与" />
                                                <ComboBoxItem Content="监测源" />
                                                <ComboBoxItem Content="受控播放器" />
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" SelectedIndex="{Binding MethodIndex, Mode=TwoWay}"
                                                      Margin="0,0,8,0" Visibility="{Binding MethodVisibility}">
                                                <ComboBoxItem Content="自动 (SMTC)" />
                                                <ComboBoxItem Content="热键" />
                                            </ComboBox>
                                            <Button Grid.Column="3" Content="测试" Style="{StaticResource GhostButton}"
                                                    Padding="8,4" Click="OnTestPlayer" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============ 通用 ============ -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="MutexCheck" Content="互斥开关：监测源出声时暂停受控播放器" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="恢复策略" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ModeCombo" Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem Content="严格（关闭才恢复）" />
                                        <ComboBoxItem Content="宽松（静音即恢复）" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AutostartCheck" Content="开机自动启动" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,6">
                            <TextBlock Text="时间参数" Style="{StaticResource SectionTitle}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TimingHint" Text="" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="恢复默认" Style="{StaticResource GhostButton}"
                                        Padding="8,3" Click="OnResetTiming" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="恢复延迟" VerticalAlignment="Center" />
                                        <Button x:Name="HelpRecoveryButton" Style="{StaticResource HelpButton}" Content="?"
                                                AutomationProperties.Name="恢复延迟说明" Click="OnHelpClick">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource HelpTip}">
                                                    <StackPanel>
                                                        <TextBlock Text="恢复延迟（默认 3 秒）" Style="{StaticResource HelpTitle}" />
                                                        <TextBlock Style="{StaticResource HelpBody}"
                                                                   Text="视频或音乐关掉后，等多久再把音乐放回来，并把音量调回音乐方案。" />
                                                        <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0"
                                                                   Text="设成 0 秒会立刻恢复，但连续换几个视频时，音乐会被反复停了又开；3 秒是留一点缓冲。嫌恢复慢可以改成 1 秒。" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="RestoreSlider" Grid.Column="1" Minimum="0" Maximum="30"
                                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnTimingChanged" />
                                    <TextBlock x:Name="RestoreLabel" Grid.Column="2" Text="3 s" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="有声确认" VerticalAlignment="Center" />
                                        <Button x:Name="HelpConfirmButton" Style="{StaticResource HelpButton}" Content="?"
                                                AutomationProperties.Name="有声确认说明" Click="OnHelpClick">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource HelpTip}">
                                                    <StackPanel>
                                                        <TextBlock Text="有声确认（默认 1.5 秒）" Style="{StaticResource HelpTitle}" />
                                                        <TextBlock Style="{StaticResource HelpBody}"
                                                                   Text="一个应用要连续出声多久，才算「真的在播放」，程序才去暂停音乐。" />
                                                        <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0"
                                                                   Text="通知提示音、广告的「叮」一声如果也算，就会误停音乐，所以默认等 1.5 秒。想更快可以调到 1 秒。" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="ConfirmSlider" Grid.Column="1" Minimum="0.5" Maximum="5"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnTimingChanged" />
                                    <TextBlock x:Name="ConfirmLabel" Grid.Column="2" Text="1.5 s" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="音量渐变" VerticalAlignment="Center" />
                                        <Button x:Name="HelpFadeButton" Style="{StaticResource HelpButton}" Content="?"
                                                AutomationProperties.Name="音量渐变说明" Click="OnHelpClick">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource HelpTip}">
                                                    <StackPanel>
                                                        <TextBlock Text="音量渐变（默认 300 毫秒）" Style="{StaticResource HelpTitle}" />
                                                        <TextBlock Style="{StaticResource HelpBody}"
                                                                   Text="切换音量时，用多长时间从旧音量滑到新音量。" />
                                                        <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0"
                                                                   Text="0 毫秒会「啪」一下跳过去；300 毫秒听起来自然。嫌变化慢可以调到 100 毫秒。" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="FadeSlider" Grid.Column="1" Minimum="0" Maximum="1000"
                                            TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnTimingChanged" />
                                    <TextBlock x:Name="FadeLabel" Grid.Column="2" Text="300 ms" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="设备切换抑制" VerticalAlignment="Center" />
                                        <Button x:Name="HelpSuppressButton" Style="{StaticResource HelpButton}" Content="?"
                                                AutomationProperties.Name="设备切换抑制说明" Click="OnHelpClick">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource HelpTip}">
                                                    <StackPanel>
                                                        <TextBlock Text="设备切换抑制（默认 5 秒）" Style="{StaticResource HelpTitle}" />
                                                        <TextBlock Style="{StaticResource HelpBody}"
                                                                   Text="插耳机、拔耳机、蓝牙断开的瞬间，系统会换掉声音设备，看起来像「所有播放都关了」。" />
                                                        <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0"
                                                                   Text="这段时间先不做判断，避免把音乐误恢复出来。蓝牙耳机切换慢，可以调到 8–10 秒。" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Slider x:Name="SuppressSlider" Grid.Column="1" Minimum="2" Maximum="15"
                                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnTimingChanged" />
                                    <TextBlock x:Name="SuppressLabel" Grid.Column="2" Text="5 s" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <CheckBox x:Name="FastConfirmCheck" VerticalAlignment="Center"
                                              Content="明显有声时快速确认（约 0.6 s，不再等满「有声确认」）" />
                                    <Button x:Name="HelpFastButton" Style="{StaticResource HelpButton}" Content="?"
                                            AutomationProperties.Name="快速确认说明" Click="OnHelpClick">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HelpTip}" Placement="Top">
                                                <StackPanel>
                                                    <TextBlock Text="明显有声时快速确认（默认开）" Style="{StaticResource HelpTitle}" />
                                                    <TextBlock Style="{StaticResource HelpBody}"
                                                               Text="声音比较大、明显在放视频时，只等 0.6 秒就暂停音乐，不用等满上面的 1.5 秒。" />
                                                    <TextBlock Style="{StaticResource HelpBody}" Margin="0,6,0,0"
                                                               Text="很小的声音（比如速览预览）仍按 1.5 秒判断，避免误触发。取消勾选后，全部按 1.5 秒算。" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="SaveHint" Text="" Foreground="#107C10" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
